<RCC>
    <qresource prefix="/">
        <file>images/background.png</file>
        <!-- 草贴图变体 -->
        <file>images/grass_0.png</file>
        <file>images/grass_1.png</file>
        <file>images/grass_2.png</file>
        <!-- 备用单张草贴图（保留以兼容旧资源） -->
        <file>images/grass.png</file>
        <file>images/cow.png</file>
        <file>images/bull.png</file>
        <file>images/tiger.png</file>
        <file>images/tiger_man.png</file>
    <!-- 新的老虎精灵表（4 行 × 7 帧），按用户提供路径存放在子目录中 -->
    <file>images/grass_variants_backup/tiger_new.png</file>
    <!-- 装饰性树图片 -->
    <file>images/tree1.png</file>
    <file>images/tree2.png</file>
    <file>images/tree3.png</file>
        <file>music/background_music.mp3</file>
        <file>images/background_start.png</file>

        <!-- 配置 YAML：使用 alias 保持资源路径为 ":/config/..." -->
        <file alias="config/map_config.yaml">../config/map_config.yaml</file>
        <file alias="config/species.yaml">../config/species.yaml</file>
        <!-- 基础模板 YAML -->
        <file alias="config/species_base/base_animal.yaml">../config/species_base/base_animal.yaml</file>
        <file alias="config/species_base/base_plant.yaml">../config/species_base/base_plant.yaml</file>
        <!-- 物种定义：动物 -->
        <file alias="config/species/animals/cow.yaml">../config/species/animals/cow.yaml</file>
        <file alias="config/species/animals/tiger.yaml">../config/species/animals/tiger.yaml</file>
        <!-- 行为树 YAML -->
        <file alias="config/species/animals/bt/cow_bt.yaml">../config/species/animals/bt/cow_bt.yaml</file>
        <file alias="config/species/animals/bt/tiger_bt.yaml">../config/species/animals/bt/tiger_bt.yaml</file>
        <!-- 物种定义：植物 -->
        <file alias="config/species/plants/grass.yaml">../config/species/plants/grass.yaml</file>
    </qresource>
</RCC>